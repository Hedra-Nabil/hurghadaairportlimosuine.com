---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

const pageTitle = "FAQ | Hurghada Airport Limousine Help Center";
const pageDesc = "Frequently asked questions about Hurghada Airport transfers: Terminal 1 & 2 meeting points, Egypt tourist visa on arrival, dive gear, flight delays, and fixed pricing.";
const canonicalUrl = "https://hurghadaairportlimosuine.com/faq/";

const faqCategories = [
  {
    category: "Arrival & Driver Meeting Point",
    items: [
      {
        q: "Where will my driver meet me at Hurghada International Airport (HRG)?",
        a: "Due to civil aviation airport security regulations, private drivers are not permitted inside the baggage claim hall. Your driver will wait directly outside the terminal exit sliding glass doors under the covered greeting canopy holding a prominent name board with your name. They will assist you with your luggage directly to your vehicle."
      },
      {
        q: "What happens if my inbound flight to Hurghada is delayed?",
        a: "We track all flights in real time using your flight number. Your driver's pickup schedule is automatically adjusted to your actual landing time at zero extra cost. Your complimentary 60-minute waiting time begins only after the aircraft touches down."
      },
      {
        q: "Which terminal will my flight arrive at?",
        a: "Hurghada Airport operates Terminal 1 (primarily international scheduled and European charter flights) and Terminal 2 (domestic EgyptAir flights and select regional charter carriers). We monitor your airline flight code and dispatch our driver to the exact terminal where your flight docks."
      }
    ]
  },
  {
    category: "Egypt Tourist Visa & Airport Customs",
    items: [
      {
        q: "Do I need an Egypt entry visa to enter through Hurghada Airport?",
        a: "Yes. Hurghada is located in mainland Egypt (Red Sea Governorate), meaning the free Sinai stamp does not apply here. All foreign tourists from eligible nations (UK, EU, US, Canada, Australia, etc.) must obtain an Egypt Tourist Visa. You can purchase the $25 USD visa sticker upon arrival at the official 24/7 bank kiosks (Banque Misr / National Bank of Egypt) right before passport control, or apply online in advance for an official Egypt eVisa."
      },
      {
        q: "How long does it take to clear passport control and baggage claim at HRG?",
        a: "Typically 20 to 45 minutes depending on seasonal flight arrivals. Our 60 minutes of complimentary waiting time gives you ample time to purchase your visa sticker, clear immigration, collect baggage, and exit comfortably."
      }
    ]
  },
  {
    category: "Pricing, Payment & Currency",
    items: [
      {
        q: "Are transfer fares charged per person or per vehicle?",
        a: "All prices on Hurghada Airport Limousine are strictly per private vehicle, covering your entire private party and all luggage up to the vehicle's capacity."
      },
      {
        q: "What currencies do you accept?",
        a: "We accept payments in USD, EUR, GBP, and Egyptian Pounds (EGP). You can reserve online securely or pay your driver in cash upon arrival."
      },
      {
        q: "Are airport gate fees and highway security tolls included?",
        a: "Yes, 100%. All Red Sea highway checkpoints, airport parking gate tickets, and resort entry passes are completely included in your quoted fare. There are no surprise fees or toll demands."
      }
    ]
  },
  {
    category: "Luggage, Diving Equipment & Child Safety",
    items: [
      {
        q: "Can you transport scuba diving and kitesurfing gear bags?",
        a: "Yes. Hurghada and El Gouna are world-renowned diving and kitesurfing hubs, and our fleet is prepared for sports travelers. For groups with multiple heavy dive equipment bags, kiteboards, and hard luggage, we recommend booking our Private Minivan (Toyota HiAce / Mercedes Vito) for maximum comfort."
      },
      {
        q: "Are child car seats or infant booster seats available?",
        a: "Yes, we provide European-certified sanitized rear-facing infant seats and forward-facing booster seats upon request during booking at a nominal fee of $10."
      },
      {
        q: "Do you provide transfers to El Gouna, Sahl Hasheesh, Makadi Bay, and Soma Bay?",
        a: "Yes, we provide direct 24/7 private transfers from Hurghada Airport to El Gouna (approx. 30 mins), Sahl Hasheesh (approx. 20 mins), Makadi Bay (approx. 25 mins), Soma Bay (approx. 45 mins), Safaga, and Marsa Alam in air-conditioned vehicles with authorized tourism permits."
      }
    ]
  },
  {
    category: "Cancellations & Modifications",
    items: [
      {
        q: "What is your cancellation policy?",
        a: "You can cancel or modify your transfer reservation free of charge with a 100% full refund up to 24 hours prior to your scheduled pickup time."
      },
      {
        q: "What if my flight to Hurghada is cancelled by the airline?",
        a: "If your flight is cancelled or rescheduled by your airline, simply notify our dispatch team on WhatsApp or email, and we will update your pickup time or issue a full refund immediately."
      }
    ]
  }
];

const allFaqs = faqCategories.flatMap(c => c.items);
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allFaqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout 
  title={pageTitle} 
  description={pageDesc} 
  canonicalUrl={canonicalUrl}
  schema={faqSchema}
>
  <Header />

  <main class="bg-white">
    <div class="bg-slate-950 text-white pt-10 pb-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto space-y-4 text-center md:text-left">
        <Breadcrumbs items={[{ name: "Help Center & FAQ", url: "/faq" }]} />
        <span class="inline-block px-3 py-1 bg-amber-400/20 text-amber-300 text-xs font-black uppercase tracking-wider rounded-full">
          Frequently Asked Questions
        </span>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
          Hurghada Airport Help Center
        </h1>
        <p class="text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
          Everything you need to know about booking, airport meeting points, Egypt tourist visa on arrival, diving luggage, and fixed pricing.
        </p>
      </div>
    </div>

    <!-- Categorized FAQ Accordions -->
    <section class="py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      {faqCategories.map((cat) => (
        <div class="space-y-4">
          <h2 class="text-xl font-black text-slate-900 border-b border-slate-200 pb-2">
            {cat.category}
          </h2>
          <div class="space-y-3">
            {cat.items.map((item) => (
              <details class="group bg-slate-50 rounded-2xl border border-slate-200 p-5 open:bg-white open:border-amber-400 open:shadow-md transition">
                <summary class="font-bold text-slate-900 text-sm sm:text-base cursor-pointer list-none flex items-center justify-between">
                  <span>{item.q}</span>
                  <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <p class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
                  {item.a}
                </p>
              </details>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- Still Have Questions? -->
    <section class="py-16 bg-slate-50 border-t border-slate-200/60">
      <div class="max-w-3xl mx-auto px-4 text-center space-y-4">
        <h3 class="text-xl sm:text-2xl font-black text-slate-900">
          Have a Specific Question About Your Arrival?
        </h3>
        <p class="text-slate-600 text-sm">
          Our Hurghada airport dispatch team is online 24 hours a day on WhatsApp to assist with flight schedules, dive gear baggage, or custom Red Sea itineraries.
        </p>
        <div class="pt-2 flex justify-center gap-4">
          <a 
            href="https://wa.me/201094066018" 
            target="_blank" 
            class="px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-xs rounded-xl shadow-md transition"
          >
            Chat with Hurghada Dispatch on WhatsApp
          </a>
          <a 
            href="/contact" 
            class="px-6 py-3 bg-white border border-slate-200 hover:border-slate-300 text-slate-800 font-bold text-xs rounded-xl transition"
          >
            Contact Support Form
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>
